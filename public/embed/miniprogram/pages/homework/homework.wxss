.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f1f5f9;
}

.header {
  padding: 24rpx 28rpx 12rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.toolbar {
  display: flex;
  gap: 12rpx;
  padding: 0 28rpx 16rpx;
  align-items: center;
}

.input {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
}

web-view {
  flex: 1;
  width: 100%;
}

.log-panel {
  max-height: 280rpx;
  overflow: auto;
  background: #0f172a;
  color: #e2e8f0;
  padding: 16rpx 24rpx;
}

.log-title {
  font-size: 24rpx;
  margin-bottom: 12rpx;
  color: #94a3b8;
}

.empty {
  font-size: 22rpx;
  color: #64748b;
}

.log-item {
  padding: 10rpx 0;
  border-bottom: 1px solid #334155;
}

.log-type {
  display: block;
  font-size: 24rpx;
  color: #38bdf8;
}

.log-time,
.log-body {
  display: block;
  font-size: 22rpx;
  color: #cbd5e1;
}
