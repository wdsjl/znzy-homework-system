{
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:standalone": "concurrently \"npm run dev:api\" \"vite --host 0.0.0.0 --mode standalone\"",
    "dev:api": "node server/index.cjs",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "db:seed": "node server/scripts/seed-db.cjs",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "test:e2e-grading": "node server/scripts/e2e-async-grading.cjs",
    "test:e2e-grading:http": "node server/scripts/e2e-async-grading.cjs --http",
    "test:e2e-grading:redis": "REDIS_URL=redis://127.0.0.1:6379 node server/scripts/e2e-async-grading.cjs --backend=redis --http"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bullmq": "^5.78.0",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "mammoth": "latest",
    "multer": "latest",
    "mysql2": "latest",
    "perspective-transform": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "sharp": "latest",
    "tesseract.js": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
