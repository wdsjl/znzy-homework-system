# Windows 本机 Node 模式（与 sa/door 站点相同：Nginx 反代到本地端口）
API_PORT=3200
SERVE_STATIC=1
ASYNC_GRADING=1
PUBLIC_ORIGIN=https://znzy.lhyun.net
CORS_ORIGIN=https://znzy.lhyun.net

# 可选：MySQL（需本机或远程 MySQL 后再启用）
# DATABASE_URL=mysql://znzy:znzy@127.0.0.1:3306/znzy_homework

# 可选：Redis 异步队列
# REDIS_URL=redis://127.0.0.1:6379

# 可选：LLM 主观题判分
# LLM_API_KEY=
