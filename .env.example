# API 端口
API_PORT=4000

# MySQL 连接（任选一种方式配置；未配置时使用 JSON 文件存储）
# DATABASE_URL=mysql://znzy:znzy@127.0.0.1:3306/znzy_homework
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=znzy_homework

# 使用 database-schema.sql 正式表结构（默认使用 runtime 简化表 znzy_*）
# USE_FORMAL_SCHEMA=1

# LLM 语义判分（OpenAI 兼容接口，未配置时仅使用模糊相似度）
# LLM_API_KEY=sk-...
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=12000

# 异步批改队列（上传后立即返回 jobId，后台 OCR/LLM）
# ASYNC_GRADING=1

# Redis 生产级任务队列（未配置时回退内存队列 + grading-jobs.json）
# REDIS_URL=redis://127.0.0.1:6379
# GRADING_WORKER_CONCURRENCY=2
